# TRACE-AI environment variables
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

GEMINI_API_KEY=
# Primary Gemini model. It is checked against the live Models API.
GEMINI_MODEL=gemini-2.5-flash
# Optional comma-separated fallback preferences. Only live-supported generateContent models are eligible.
GEMINI_FALLBACK_MODELS=
# Bounded retries per model for transient 408/429/5xx responses.
GEMINI_MAX_RETRIES=2

HF_TOKEN=
LANGSEARCH_API_KEY=
SOURCE_SEARCH_API_KEY=
