# ==============================================================================
# TRACE-AI: Environment Variables Configurations Example
# ==============================================================================

# Supabase Configurations (Optional)
# If left blank, the application automatically initializes a local SQLite 
# database ('backend/data/trace_ai.db') and stores uploads locally in 'backend/uploads/'.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini API Configurations (Optional)
# Used for multimodal vision analysis, narrative reasoning, OCR parsing, and report summaries.
# If left blank, TRACE-AI runs local rule-based diagnostics and fallbacks gracefully.
GEMINI_API_KEY=

# Hugging Face Configurations (Optional)
HF_TOKEN=

# Source Tracing Search Configurations (Optional)
# Used for real-time web crawler and similar media searches (supports Tavily search API key).
# If left blank, searches fall back to matching domains within metadata.
SOURCE_SEARCH_API_KEY=
